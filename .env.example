# Пути к логам на хосте (Linux). Должны быть абсолютными — Docker bind-mount.
SURICATA_LOG_DIR=/var/log/suricata
ZEEK_LOG_DIR=/opt/zeek/logs/current

# Для локальной проверки на Windows — логи из IDS Lab:
# SURICATA_LOG_DIR=C:/Users/admin/Documents/PR/IDS/logs/suricata
# ZEEK_LOG_DIR=C:/Users/admin/Documents/PR/IDS/logs/zeek

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Grafana слушает на всех интерфейсах (доступ из сети).
GRAFANA_BIND=0.0.0.0
GRAFANA_PORT=3000

# HTTPS. ROOT_URL и CERT_SAN — IP/DNS сенсора, с которого открывают UI.
# Пример для доступа из сети:
#   GRAFANA_ROOT_URL=https://10.0.0.50:3000
#   GRAFANA_CERT_SAN=DNS:ids-sensor.lab,IP:10.0.0.50,DNS:localhost,IP:127.0.0.1
# После смены SAN удалите certs/grafana.* и перезапустите compose (перегенерация).
GRAFANA_ROOT_URL=https://localhost:3000
GRAFANA_CERT_CN=ids-grafana
GRAFANA_CERT_SAN=DNS:localhost,IP:127.0.0.1
GRAFANA_TLS_DAYS=825

# Хранение в Loki (168h = 7 дней)
LOKI_RETENTION=168h

# Первичная загрузка существующих логов (один раз):
# VECTOR_CONFIG=vector.bootstrap.toml
