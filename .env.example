# Пути к логам на хосте (Linux). Абсолютные пути для Docker bind-mount.
SURICATA_LOG_DIR=/var/log/suricata

# ВАЖНО: родительский каталог логов Zeek, НЕ .../current
# (current — symlink; после zeekctl deploy/ротации mount на current «залипает»).
ZEEK_LOGS_ROOT=/opt/zeek/logs
ZEEK_LOG_SUBDIR=current

# Windows / IDS Lab (файлы сразу в каталоге, без current):
# SURICATA_LOG_DIR=C:/Users/admin/Documents/PR/IDS/logs/suricata
# ZEEK_LOGS_ROOT=C:/Users/admin/Documents/PR/IDS/logs/zeek
# ZEEK_LOG_SUBDIR=.

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

GRAFANA_BIND=0.0.0.0
GRAFANA_PORT=3000

GRAFANA_ROOT_URL=https://localhost:3000
GRAFANA_CERT_CN=ids-grafana
GRAFANA_CERT_SAN=DNS:localhost,IP:127.0.0.1
GRAFANA_TLS_DAYS=825

LOKI_RETENTION=168h

# VECTOR_CONFIG=vector.bootstrap.toml
