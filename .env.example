# Пути к логам на хосте (Linux). Абсолютные пути для Docker bind-mount.
SURICATA_LOG_DIR=/var/log/suricata

# Родительский spool (не logger/): после zeekctl deploy logger пересоздаётся,
# bind на сам logger «отваливается». Монт spool/ это переживает.
# Live-логи: /opt/zeek/spool/logger/*.log
ZEEK_SPOOL_DIR=/opt/zeek/spool

# Windows / IDS Lab — родитель каталога, внутри которого лежит logger/ с *.log:
# SURICATA_LOG_DIR=C:/Users/admin/Documents/PR/IDS/logs/suricata
# ZEEK_SPOOL_DIR=C:/Users/admin/Documents/PR/IDS/logs/pcap
# (файлы: .../pcap/zeek/ → переименуйте/положите в .../pcap/logger/notice.log
#  либо сделайте junction logger → zeek)

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

GRAFANA_BIND=0.0.0.0
GRAFANA_PORT=3000

GRAFANA_ROOT_URL=https://localhost:3000
GRAFANA_CERT_CN=ids-grafana
GRAFANA_CERT_SAN=DNS:localhost,IP:127.0.0.1
GRAFANA_TLS_DAYS=825

LOKI_RETENTION=168h

# VECTOR_CONFIG=vector.bootstrap.toml
