# Пути к логам на хосте (Linux). Абсолютные пути для Docker bind-mount.
SURICATA_LOG_DIR=/var/log/suricata

# zeekctl: /opt/zeek/logs/current → /opt/zeek/spool/logger
# Монтируем реальный каталог записи (не symlink logs/current).
ZEEK_SPOOL_LOGGER=/opt/zeek/spool/logger

# Windows / IDS Lab (файлы лежат прямо в каталоге логов):
# SURICATA_LOG_DIR=C:/Users/admin/Documents/PR/IDS/logs/suricata
# ZEEK_SPOOL_LOGGER=C:/Users/admin/Documents/PR/IDS/logs/zeek

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

GRAFANA_BIND=0.0.0.0
GRAFANA_PORT=3000

GRAFANA_ROOT_URL=https://localhost:3000
GRAFANA_CERT_CN=ids-grafana
GRAFANA_CERT_SAN=DNS:localhost,IP:127.0.0.1
GRAFANA_TLS_DAYS=825

LOKI_RETENTION=168h

# VECTOR_CONFIG=vector.bootstrap.toml
