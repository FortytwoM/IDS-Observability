      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"ids\", vendor=\"zeek\", log_type=\"notice\"} [1m]))",
