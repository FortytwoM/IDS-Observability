      "targets": [
        {
          "expr": "max(max_over_time({job=\"ids\", vendor=\"zeek\", log_type=\"capture_loss\"} | json | unwrap gaps [15m]))",
          "legendFormat": "gaps",
          "refId": "A"
        }
      ],
      "title": "Zeek — потери (capture gaps)",
