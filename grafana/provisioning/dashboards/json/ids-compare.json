      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false } },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"ids\", vendor=\"zeek\", log_type=\"intel\"} [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Zeek intel hits",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2, "showPoints": "never", "stacking": { "mode": "none" } }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 10,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum by (vendor) (count_over_time({job=\"ids\", log_type=~\"alert|notice|intel\"} [1m]))",
          "legendFormat": "{{vendor}}",
          "refId": "A"
        }
      ],
      "title": "События в минуту (сравнение)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 11,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "max(max_over_time({job=\"ids\", vendor=\"suricata\", log_type=\"stats\"} | json | unwrap kernel_drops [5m]))",
          "legendFormat": "kernel_drops",
          "refId": "A"
        },
        {
          "expr": "max(max_over_time({job=\"ids\", vendor=\"zeek\", log_type=\"capture_loss\"} | json | unwrap gaps [5m]))",
          "legendFormat": "zeek_gaps",
          "refId": "B"
        }
      ],
      "title": "Здоровье сенсора",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "Алерты",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 14 },
