          "expr": "{job=\"ids\", log_type=~\"alert|notice|intel\"} | json | community_id = \"$community_id\" | line_format \"{{.vendor}} {{.log_type}} {{.alert_title}} {{.src_ip}} -> {{.dest_ip}}\"",
          "refId": "A"
        }
      ],
      "title": "События по community_id (оба движка)",
      "type": "logs"
