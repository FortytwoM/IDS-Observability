        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"ids\", vendor=\"suricata\", log_type=\"alert\"} | json | src_ip != \"\" | line_format \"{{.severity}} {{.signature_id}} {{.alert_title}} {{.src_ip}} -> {{.dest_ip}} cid={{.community_id}}\"",
          "refId": "A"
        }
      ],
      "title": "Suricata — последние алерты",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 14 },
      "id": 21,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"ids\", vendor=\"zeek\", log_type=~\"notice|intel\"} | json | line_format \"{{.note}} {{.alert_title}} {{.src_ip}} -> {{.dest_ip}} cid={{.community_id}}\"",
          "refId": "A"
        }
      ],
      "title": "Zeek — notices / intel",
      "type": "logs"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": []
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 30,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true, "sortBy": [{ "desc": true, "displayName": "Value" }] },
      "targets": [
        {
          "expr": "topk(10, sum by (alert_title) (count_over_time({job=\"ids\", vendor=\"suricata\", log_type=\"alert\"} | json [$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Top Suricata signatures",
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        { "id": "organize", "options": { "renameByName": { "Value": "count", "alert_title": "signature" } } }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 31,
      "options": { "cellHeight": "sm", "showHeader": true },
      "targets": [
        {
          "expr": "topk(10, sum by (note) (count_over_time({job=\"ids\", vendor=\"zeek\", log_type=\"notice\"} | json [$__range])))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Top Zeek notice types",
      "transformations": [
        { "id": "labelsToFields", "options": { "mode": "columns" } },
        { "id": "organize", "options": { "renameByName": { "Value": "count", "note": "notice" } } }
