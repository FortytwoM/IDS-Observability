      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"ids\", vendor=\"suricata\", log_type=\"alert\"} [1m]))",
