      "targets": [
        {
          "expr": "sum(count_over_time({job=\"ids\", vendor=\"suricata\", log_type=\"alert\"} | json | signature_id !~ \"2210029|2210045\" | (src_ip =~ \"${host}\" or dest_ip =~ \"${host}\" or src =~ \"${host}\" or dst =~ \"${host}\") | signature_id =~ \"${sid}\" | alert_title =~ \"${alert}\" |~ \"${port}\" [$__range]))",
